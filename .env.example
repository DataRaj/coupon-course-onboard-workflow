APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace?sslmode=disable

# Reuse the host application's JWT secret. Leave DEV_AUTH_ENABLED=false in any
# shared/production environment; startup refuses DEV_AUTH_ENABLED=true when
# APP_ENV=production.
JWT_SECRET=
DEV_AUTH_ENABLED=true
DEV_USER_ID=00000000-0000-0000-0000-0000000000de

PABBLY_BASE_URL=https://payments.pabbly.com/api/v1
PABBLY_API_KEY=
PABBLY_SECRET_KEY=
PABBLY_TIMEOUT=15s

CATALOG_SYNC_INTERVAL=2m
CATALOG_HARD_STALE_AFTER=30m
PRICE_QUOTE_MAX_AGE=60s
REDEMPTION_TTL=30m

PABBLY_WEBHOOK_SECRET=

# Optional manual PW public catalog ingestion (worker ingest-pw-batch).
# PW_LISTING_URL=https://www.pw.live/iit-jee/class-12/batches
# PW_BATCH_URL=https://www.pw.live/iit-jee/class-12/batches/lakshya-jee-in-english-2027-348091
# PW_EXPECTED_TITLE=Lakshya JEE in English 2027
# PW_BROWSER_TIMEOUT=90s
# PW_NAVIGATION_TIMEOUT=45s
# PW_HEADLESS=true
# PW_TRACE=false
# PW_TRACE_DIR=logs/pw-traces
